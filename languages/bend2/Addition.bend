# suc is injective
def pred(n: Nat) -> Nat:
  match n:
    case 0n:
      0n
    case 1n+p:
      p

law succ_inj:
  for -x: Nat
  for -y: Nat
  for h: {1n+x == 1n+y : Nat}
  {x == y : Nat}

def succ_inj(x, y, h):
  Equal.cong(Nat, Nat, pred, 1n+x, 1n+y, h)


# +-cancelʳ
law add_right_cancel:
  for -x: Nat
  for -y: Nat
  for z: Nat
  for h: {Refl.add(x, z) == Refl.add(y, z) : Nat}
  {x == y : Nat}

def add_right_cancel(x, y, z, h):
  match z:
    case 0n:
      h
    case 1n+p:
      add_right_cancel(x, y, p, succ_inj(Refl.add(x, p), Refl.add(y, p), h))


# Reading: a finite sum
def sum(xs: +List<Nat>) -> Nat:
  match xs:
    case Nil{}:
      0n
    case Con{h, t}:
      Refl.add(sum(t), h)

def zeros(n: Nat) -> +List<Nat>:
  match n:
    case 0n:
      []
    case 1n+p:
      0n <> zeros(p)

law sum_zeros:
  for n: Nat
  {sum(zeros(n)) == 0n : Nat}

def sum_zeros(n):
  match n:
    case 0n:
      {==}
    case 1n+p:
      sum_zeros(p)

