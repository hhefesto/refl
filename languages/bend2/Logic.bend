# Impossible equations
def disc(n: Nat) -> Type:
  match n:
    case 0n:
      Empty
    case 1n+p:
      Unit

law zero_ne_succ:
  for -n: Nat
  {0n != 1n+n : Nat}

def zero_ne_succ(n):
  e =>
    %Equal.sym(Nat, 0n, 1n+n, e) : disc(_)
    Unit{}


# A decision with evidence
law is_zero:
  for n: Nat
  Refl.Dec<{n == 0n : Nat}>

def is_zero(n):
  match n:
    case 0n:
      Refl.Yes{{==}}
    case 1n+p:
      Refl.No{e => zero_ne_succ(p, Equal.sym(Nat, 1n+p, 0n, e))}


# Decidable equality
def pred(n: Nat) -> Nat:
  match n:
    case 0n:
      0n
    case 1n+p:
      p

law map_succ:
  for -m: Nat
  for -n: Nat
  for d: Refl.Dec<{m == n : Nat}>
  Refl.Dec<{1n+m == 1n+n : Nat}>

def map_succ(m, n, d):
  match d:
    case Refl.Yes{p}:
      Refl.Yes{Equal.cong(Nat, Nat, x => 1n+x, m, n, p)}
    case Refl.No{np}:
      Refl.No{e => np(Equal.cong(Nat, Nat, pred, 1n+m, 1n+n, e))}

law dec_eq:
  for m: Nat
  for n: Nat
  Refl.Dec<{m == n : Nat}>

def dec_eq(m, n):
  match m n:
    case 0n 0n:
      Refl.Yes{{==}}
    case 0n 1n+q:
      Refl.No{zero_ne_succ(q)}
    case 1n+p 0n:
      Refl.No{e => zero_ne_succ(p, Equal.sym(Nat, 1n+p, 0n, e))}
    case 1n+p 1n+q:
      map_succ(p, q, dec_eq(p, q))


# If and only if
law and_swap_iff:
  for -A: Type
  for -B: Type
  ((A & B) -> (B & A)) & ((B & A) -> (A & B))

def and_swap_iff(A, B):
  (p => and_swap(A, B, p), p => and_swap(B, A, p))


# Reading: languages as predicates
def union(-P: Nat -> Type, -Q: Nat -> Type, n: Nat) -> Type:
  P(n) | Q(n)

def inter(-P: Nat -> Type, -Q: Nat -> Type, n: Nat) -> Type:
  P(n) & Q(n)

law inter_sub_union:
  for -P: Nat -> Type
  for -Q: Nat -> Type
  for -n: Nat
  for pq: inter(P, Q, n)
  union(P, Q, n)

def inter_sub_union(P, Q, n, pq):
  (p, q) = pq
  Inl{p}

