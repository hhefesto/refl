# Implication is a function
law modus_ponens:
  for -A: Type
  for -B: Type
  for a: A
  for f: A -> B
  B

def modus_ponens(A, B, a, f):
  f(a)


# And is a pair
law and_swap:
  for -A: Type
  for -B: Type
  for p: A & B
  B & A

def and_swap(A, B, p):
  (a, b) = p
  (b, a)


# Or is a choice
law or_swap:
  for -A: Type
  for -B: Type
  for s: A | B
  B | A

def or_swap(A, B, s):
  match s:
    case Inl{a}:
      Inr{a}
    case Inr{b}:
      Inl{b}


