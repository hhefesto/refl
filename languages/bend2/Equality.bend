law trans_:
  for -x: Nat
  for -y: Nat
  for -z: Nat
  for p: {x == y : Nat}
  for q: {y == z : Nat}
  {x == z : Nat}

def trans_(x, y, z, p, q):
  Refl.subst(Nat, w => {x == w : Nat}, y, z, q, p)


# Pattern matching on refl is J
law J:
  for -A: Type
  for -x: A
  for -P: @y:A -> @e:{x == y : A} -> Type
  for d: P(x, {==})
  for -y: A
  for p: {x == y : A}
  P(y, p)

def J(A, x, P, d, y, p):
  %E@p : P(_, E)
  d


# Equations between proofs
law trans_sym:
  for -A: Type
  for -x: A
  for -y: A
  for e: {x == y : A}
  {Equal.trans(A, y, x, y, Equal.sym(A, x, y, e), e) == {==} : {y == y : A}}

def trans_sym(A, x, y, e):
  %E@e : {Equal.trans(A, _, x, _, Equal.sym(A, x, _, E), E) == {==} : {_ == _ : A}}
  {==}


# A canonical proof
law canon_of:
  for -x: Nat
  for -y: Nat
  for d: Refl.Dec<{x == y : Nat}>
  for p: {x == y : Nat}
  {x == y : Nat}

def canon_of(x, y, d, p):
  match d:
    case Refl.Yes{q}:
      q
    case Refl.No{n}:
      Empty.absurd({x == y : Nat}, n(p))

law canon_const:
  for -x: Nat
  for -y: Nat
  for d: Refl.Dec<{x == y : Nat}>
  for p: {x == y : Nat}
  for q: {x == y : Nat}
  {canon_of(x, y, d, p) == canon_of(x, y, d, q) : {x == y : Nat}}

def canon_const(x, y, d, p, q):
  match d:
    case Refl.Yes{r}:
      {==}
    case Refl.No{n}:
      Empty.absurd({canon_of(x, y, Refl.No{n}, p) == canon_of(x, y, Refl.No{n}, q) : {x == y : Nat}}, n(p))

def canon(+x: Nat, +y: Nat, p: {x == y : Nat}) -> {x == y : Nat}:
  canon_of(x, y, Logic.dec_eq(x, y), p)

law canon_inv:
  for +x: Nat
  for +y: Nat
  for p: {x == y : Nat}
  {Equal.trans(Nat, x, x, y, Equal.sym(Nat, x, x, canon(x, x, {==})), canon(x, y, p)) == p : {x == y : Nat}}

def canon_inv(x, y, p):
  %E@p : {Equal.trans(Nat, x, x, _, Equal.sym(Nat, x, x, canon(x, x, {==})), canon(x, _, E)) == E : {x == _ : Nat}}
  trans_sym(Nat, x, x, canon(x, x, {==}))


# Hedberg: decidable equality gives UIP
law eq_irrelevant:
  for +x: Nat
  for +y: Nat
  for +p: {x == y : Nat}
  for +q: {x == y : Nat}
  {p == q : {x == y : Nat}}

def eq_irrelevant(x, y, p, q):
  Equal.trans({x == y : Nat}, p, Equal.trans(Nat, x, x, y, Equal.sym(Nat, x, x, canon(x, x, {==})), canon(x, y, q)), q,
    Equal.trans({x == y : Nat}, p, Equal.trans(Nat, x, x, y, Equal.sym(Nat, x, x, canon(x, x, {==})), canon(x, y, p)), Equal.trans(Nat, x, x, y, Equal.sym(Nat, x, x, canon(x, x, {==})), canon(x, y, q)),
      Equal.sym({x == y : Nat}, Equal.trans(Nat, x, x, y, Equal.sym(Nat, x, x, canon(x, x, {==})), canon(x, y, p)), p, canon_inv(x, y, p)),
      Equal.cong({x == y : Nat}, {x == y : Nat}, r => Equal.trans(Nat, x, x, y, Equal.sym(Nat, x, x, canon(x, x, {==})), r), canon(x, y, p), canon(x, y, q), canon_const(x, y, Logic.dec_eq(x, y), p, q))),
    canon_inv(x, y, q))


# Reading: δ is symmetric
law pick_sym:
  for +i: Nat
  for +j: Nat
  for d: Refl.Dec<{i == j : Nat}>
  for b: Refl.Dec<{j == i : Nat}>
  {pick({i == j : Nat}, d) == pick({j == i : Nat}, b) : Nat}

law delta_sym:
  for +i: Nat
  for +j: Nat
  {delta(i, j) == delta(j, i) : Nat}

def pick_sym(i, j, d, b):
  match d b:
    case Refl.Yes{p} Refl.Yes{q}:
      {==}
    case Refl.Yes{p} Refl.No{nq}:
      Empty.absurd({1n == 0n : Nat}, nq(Equal.sym(Nat, i, j, p)))
    case Refl.No{np} Refl.Yes{q}:
      Empty.absurd({0n == 1n : Nat}, np(Equal.sym(Nat, j, i, q)))
    case Refl.No{np} Refl.No{nq}:
      {==}

def delta_sym(i, j):
  pick_sym(i, j, Logic.dec_eq(i, j), Logic.dec_eq(j, i))

