# Matching on refl
law cong_:
  for -A: Type
  for -B: Type
  for -f: A -> B
  for -x: A
  for -y: A
  for p: {x == y : A}
  {f(x) == f(y) : B}

def cong_(A, B, f, x, y, p):
  %p : {f(x) == f(_) : B}
  {==}


# Function equality and ≗
law cong_app:
  for -A: Type
  for -B: Type
  for -f: A -> B
  for -g: A -> B
  for e: {f == g : A -> B}
  for -x: A
  {f(x) == g(x) : B}

def Pointwise(-A: Type, -B: Type, -f: A -> B, -g: A -> B) -> Type:
  @x:A -> {f(x) == g(x) : B}

law pointwise_trans:
  for -A: Data
  for -B: Type
  for -f: A -> B
  for -g: A -> B
  for -h: A -> B
  for p: Pointwise(A, B, f, g)
  for q: Pointwise(A, B, g, h)
  for +x: A
  {f(x) == h(x) : B}

def cong_app(A, B, f, g, e, x):
  %e : {f(x) == _(x) : B}
  {==}

def pointwise_trans(A, B, f, g, h, p, q, x):
  Equal.trans(B, f(x), g(x), h(x), p(x), q(x))


# Rewrite chains
law two_three:
  for -x: Nat
  for -y: Nat
  for p: {x == 2n : Nat}
  for q: {y == 3n : Nat}
  {Refl.add(x, y) == 5n : Nat}

def two_three(x, y, p, q):
  %Equal.sym(Nat, x, 2n, p) : {Refl.add(_, y) == 5n : Nat}
  %Equal.sym(Nat, y, 3n, q) : {Refl.add(2n, _) == 5n : Nat}
  {==}


# Pattern-matching lambdas
law sym_:
  for -A: Type
  for -x: A
  for -y: A
  {x == y : A} -> {y == x : A}

def sym_(A, x, y):
  e =>
    %e : {_ == x : A}
    {==}


# with abstraction
def pick(-A: Type, d: Refl.Dec<A>) -> Nat:
  match d:
    case Refl.Yes{p}:
      1n
    case Refl.No{q}:
      0n

def delta(i: Nat, j: Nat) -> Nat:
  pick({i == j : Nat}, Logic.dec_eq(i, j))

law pick_yes:
  for -A: Type
  for a: A
  for d: Refl.Dec<A>
  {pick(A, d) == 1n : Nat}

law delta_diag:
  for +i: Nat
  {delta(i, i) == 1n : Nat}

def pick_yes(A, a, d):
  match d:
    case Refl.Yes{p}:
      {==}
    case Refl.No{q}:
      Empty.absurd({pick(A, Refl.No{q}) == 1n : Nat}, q(a))

def delta_diag(i):
  pick_yes({i == i : Nat}, {==}, Logic.dec_eq(i, i))


# with … in eq
def pick_b(b: Bool, +n: Nat) -> Nat:
  match b:
    case True{}:
      1n
    case False{}:
      n

def f(+n: Nat) -> Nat:
  pick_b(Refl.isZero(n), n)

law pick_b_ok:
  for +n: Nat
  for h: {n != 0n : Nat}
  for b: Bool
  for e: {Refl.isZero(n) == b : Bool}
  {pick_b(b, n) == n : Nat}

law f_nonzero:
  for +n: Nat
  for h: {n != 0n : Nat}
  {f(n) == n : Nat}

def pick_b_ok(n, h, b, e):
  match b:
    case True{}:
      Empty.absurd({pick_b(True{}, n) == n : Nat}, h(Refl.isZero_true(n, e)))
    case False{}:
      {==}

def f_nonzero(n, h):
  pick_b_ok(n, h, Refl.isZero(n), {==})


# The old inspect idiom
def pick_g(b: Bool, +n: Nat) -> Nat:
  match b:
    case True{}:
      1n
    case False{}:
      n

def g(+n: Nat) -> Nat:
  pick_g(Refl.isZero(n), n)

type Seen<-n: Nat, -b: Bool> is Type:
  Saw{evidence: {Refl.isZero(n) == b : Bool}}

law pick_g_ok:
  for +n: Nat
  for h: {n != 0n : Nat}
  for b: Bool
  for s: Seen<n, b>
  {pick_g(b, n) == n : Nat}

law g_nonzero:
  for +n: Nat
  for h: {n != 0n : Nat}
  {g(n) == n : Nat}

def pick_g_ok(n, h, b, s):
  match b s:
    case True{} Saw{e}:
      Empty.absurd({pick_g(True{}, n) == n : Nat}, h(Refl.isZero_true(n, e)))
    case False{} Saw{e}:
      {==}

def g_nonzero(n, h):
  pick_g_ok(n, h, Refl.isZero(n), Saw{{==}})


