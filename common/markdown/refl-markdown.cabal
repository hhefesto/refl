cabal-version:      2.4
name:               refl-markdown
version:            0.1.0.0
synopsis:           Markdown rendering for level prose (commonmark, sanitized by construction)
description:        Adapted from xpsoasis/common/markdown. Pure, TH-free; builds on
                    native GHC and the GHC JavaScript backend.
author:             hhefesto
maintainer:         hhefesto@rdataa.com
build-type:         Simple

library
    exposed-modules:
        Refl.Markdown
    hs-source-dirs:   .
    default-language: Haskell2010
    default-extensions:
        OverloadedStrings
    build-depends:
        base    >= 4.14 && < 5
      , text
      , commonmark
    ghc-options: -Wall
